# ============================================================
# BACKEND ENVIRONMENT VARIABLES — EXAMPLE
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# ----- Server -----------------------------------------------
PORT=3001
NODE_ENV=development

# ----- Database ---------------------------------------------
# Local: use a relative path like ./data/leads.db
# Render: set to /data/leads.db (mounted persistent disk)
DB_PATH=./data/leads.db

# ----- CORS -------------------------------------------------
# The URL(s) of the frontend (no trailing slash).
# Supports comma-separated list for multiple origins.
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ----- JWT Authentication -----------------------------------
# REQUIRED: A long, random secret for signing JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
